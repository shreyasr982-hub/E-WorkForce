{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run Ework (Chrome - Full Stack)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/e_workfroce-main/Ework-clean/Ework/admin_dashboard",
      "preLaunchTask": "Start Ework Platform"
    },
    {
      "name": "🚀 Run Ework (Edge - Full Stack)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/e_workfroce-main/Ework-clean/Ework/admin_dashboard",
      "preLaunchTask": "Start Ework Platform"
    },
    {
      "name": "🌐 Open Browser (http://localhost:5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/e_workfroce-main/Ework-clean/Ework/admin_dashboard"
    },
    {
      "name": "⚙️ Debug Backend API (Node.js)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/e_workfroce-main/Ework-clean/Ework/backend",
      "program": "${workspaceFolder}/e_workfroce-main/Ework-clean/Ework/backend/src/server.js",
      "runtimeArgs": ["--experimental-sqlite"],
      "console": "integratedTerminal"
    }
  ]
}